# Copy to backend/.env. Never commit the real .env.

# --- Runtime model for the remediation agent (optional; scanning works without it) ---
# Option A: GitHub Models (free with a GitHub account). Create a fine-grained token with "Models: read".
GITHUB_TOKEN=
# LLM_BASE_URL=https://models.github.ai/inference
# LLM_MODEL=openai/gpt-4.1-mini

# Option B: Azure OpenAI (takes precedence when all three are set)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- Server ---
# ACCESSPILOT_PORT=8000
# Loopback targets are allowed only for the bundled demo. Set to 0 on any hosted deployment.
# ACCESSPILOT_ALLOW_LOCALHOST=1
